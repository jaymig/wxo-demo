    "servers": [
        {
            "url": "https://api.xmltime.com/"
        }
    ],
    "security": [
        {
            "basic_auth": []
        }
    ],
    "paths": {
        "/businessduration": {
            "get": {
                "summary": "Business duration",
                "description": "Calculate how many business days in between two dates",
                "x-ibm-important": [
                    "startdt", "enddt"
                ],
                "parameters": [
                    {
                        "name": "version",
                        "in": "query",
                        "description": "API version",
                        "schema": {
                            "type": "string",
                            "default": "3"
                        },
                        "x-ibm-order": 1,
                        "x-ibm-multiline": "false"
                    },
                    {
                        "name": "includelastdate",
                        "in": "query",
                        "description": "Include last day in range?",
                        "schema": {
                            "type": "boolean",
                            "default": true
                        },
                        "x-ibm-order": 2,
                        "x-ibm-multiline": "false"
                    },
                    {
                        "name": "placeid",
                        "in": "query",
                        "description": "Business country and state",
                        "schema": {
                            "type": "string",
                            "default": "usa/austin"
                        },
                        "x-ibm-order": 3,
                        "x-ibm-multiline": "false"
                    },
                    {
                        "name": "startdt",
                        "in": "query",
                        "description": "Start date",
                        "schema": {
                            "type": "string",
                            "default": "2024-07-01"
                        },
                        "x-ibm-order": 4,
                        "x-ibm-multiline": "false",
                        "x-ibm-label": "Last Paycheck"
                    },
                    {
                        "name": "enddt",
                        "in": "query",
                        "description": "End date",
                        "schema": {
                            "type": "string",
                            "default": "2024-07-23"
                        },
                        "x-ibm-order": 5,
                        "x-ibm-multiline": "false",
                        "x-ibm-label": "Last work day"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Business days between start and end date",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "period": {
                                            "type": "object",
                                            "properties": {
                                                "includeddays": {
                                                    "type": "integer"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "operationId": "businessdurationget",
                "x-ibm-nl-intent-examples": [
                    "Business duration",
                    "Calculate how many business days in between two dates"
                ],
                "x-ibm-nl-entities": {
                    "entities": []
                },
                "x-ibm-conversational-skill": true,
                "x-ibm-next-actions": []
            }
        }
    },
    "components": {
        "schemas": {},
        "securitySchemes": {
            "basic_auth": {
                "type": "http",
                "scheme": "basic"
            }
        }
    }
}